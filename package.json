{
  "name": "geototal",
  "version": "1.17.0",
  "private": true,
  "description": "geoTotal: países, capitais e regiões num globo 3D interativo (app Android e versão web).",
  "license": "Apache-2.0",
  "author": "alessandrocdrx",
  "homepage": "https://github.com/alessandrocdrx/GeoTotal",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-web.mjs && node scripts/prepare-android-web.mjs",
    "check": "node scripts/build-web.mjs --check",
    "test": "node --test tests/unidade/*.test.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "icone": "node scripts/icone/gerar.cjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
